# ---- Supabase ----
# Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Clave con privilegios de servidor (NO exponer al cliente). Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Nombre del bucket de Storage donde se guardan las imágenes
SUPABASE_BUCKET="media"

# ---- Panel de administración ----
# Secreto para firmar la cookie de sesión del admin (cadena larga y aleatoria)
ADMIN_JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
# Credenciales del usuario administrador
ADMIN_EMAIL="admin@nova.com"
# Hash bcrypt de la contraseña. Genera uno con: npx bcryptjs <tu-password>
ADMIN_PASSWORD_HASH="$2a$10$ejemplo..."
